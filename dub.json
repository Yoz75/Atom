{
	"authors": [
		"yoz75"
	],
	"license": "MIT",
	"targetPath": "./bin",
	"copyright": "Copyright © 2025, yoz75",
	"name": "atom",
	"libs": [
		"raylibdll"
	],
	"description": "particles simulation (like atoms lol)",
	"dependencies": {
		"raylib-d": "~>5.5.3",
		"colorize": "~>1.0.5",
		"jsonizer": "~>0.7.7"
	},
	"buildTypes": {
		"debug": {
			"dflags": [
				"-g",
				"--mscrtlib=msvcrt",
				"./source/raylib/include/raylib.c",
				"--vgc"
			]
		},
		"release": {
			"dflags": [
				"-O3",
				"-release",
				"-boundscheck=off"
			]
		},
		"release-avx2": {
			"dflags": [
				"-O3",
				"-release",
				"-boundscheck=off",
				"--mattr=+avx2"
			]
		}
	}
}